class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {
        int n = nums.size();
        sort(nums.begin(),nums.end());
        int l=0;
        int r=n-1;
        int ans = 0;

        int sum = 0;
        int diff = INT_MAX;
        for(int i=0;i<n-2;i++){

             if(i>0 && nums[i] == nums[i-1])
               continue; 

         int l=i+1;
        int r=n-1;
        
         while(l<r){

             int sum2 = nums[l] + nums[r] + nums[i];
             int diff2 = abs(target - sum2);


             if(sum2 == target){
                return sum2;
             }
             else if(diff2 < diff){
                diff = diff2;
                ans = sum2;
             }
            
             if(sum2 > target){
              
                r--;
             }
             else{
                 
                l++;
             }
             

         }}
        
         return ans;

    }
};
