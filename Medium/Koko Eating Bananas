class Solution {
public:

     long long search(vector<int>& nums, int h,int mid){
           int n = nums.size();
        long long c = 0;
          for(int i=0;i<n;i++){
                if(nums[i]%mid == 0){
                    c = c + nums[i]/mid;
                }
                else if(nums[i]%mid != 0){
                     c = c + (nums[i]/mid) + 1;                   
                }
          } 
        

        return c;
    }          
    

    int minEatingSpeed(vector<int>& nums, int h) {

        int n = nums.size();
      int mx = *max_element(nums.begin(),nums.end());
     
         int l = 1;
         int k = mx;

        int m = 1;

         while(l<=k){
            int mid = l+(k-l)/2;

             long long x = search(nums,h,mid);
 
            if(x <= h){
                m = mid;
                k = mid-1;
            }
                 

            else
                l = mid + 1;
            


         }
         return m;
         
    }
};
