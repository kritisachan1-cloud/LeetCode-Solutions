class Solution {
public:
int binarySearch(vector<int>& nums,int x,int l,int h){
    int n=nums.size();
    
    while(l<=h){
        int mid = l+(h-l)/2;
        if(nums[mid] == x)
         return mid;
         else if(nums[mid] > x){
            h = mid-1;
         }
         else{
            l=mid+1;
         }
        
    }
     return -1;
}    

    vector<int> twoSum(vector<int>& nums, int target) {
     
        int n = nums.size();
       
         int l=0;
         int r=n-1;

 vector<int> ans={-1,-1};

         for(int l=0;l<n;l++){
             int x = binarySearch(nums, target-nums[l],l+1,n-1);
             
                if(x > -1){
                return {l+1,x+1};
             }
             
             
         }

return ans;


    }
};
