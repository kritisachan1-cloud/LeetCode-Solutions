class Solution {
public:
    int maxScore(vector<int>& nums, int k) {
        int n = nums.size();
int r = n-1;
int l = k-1;

        int lsum = 0;
for(int i=0;i<k;i++){
    lsum += nums[i];
}

int rsum = 0;
int sum = lsum;
int maxsum = sum;

     for(int i=0;i<k;i++){

         lsum = lsum-nums[l];
         l--;

           rsum = rsum+nums[r];
           r--;

        maxsum = max(rsum + lsum,maxsum);

     }
   

return maxsum;


    }
};
