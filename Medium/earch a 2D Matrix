class Solution {
public:
    bool searchMatrix(vector<vector<int>>& nums, int target) {
        int n = nums.size();
        int m = nums[0].size();

        int r = 0;
        int row = n-1;
       

        while(r<=row){
            int mid1 = r+(row-r)/2;

            
        int l=0;
        int h=m-1;


             if(nums[mid1][h] == target){
                return true;
             }


             else if(nums[mid1][h] < target){
                r= mid1+1;
             }


            else if(nums[mid1][0] <= target &&
                target <= nums[mid1][m - 1]){
                     
                    while(l<=h){
                         int mid = l+(h-l)/2;

                         if(nums[mid1][mid] == target){
                            return true;
                         }

                         else if(nums[mid1][mid] > target){
                            h = mid-1;
                         }
                         else{
                            l = mid+1;
                         }
                    }
                    
     return false;
             }


              else {
                row = mid1 - 1;
            }


        }
        return false;
    }
};
