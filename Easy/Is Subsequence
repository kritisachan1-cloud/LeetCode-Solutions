class Solution {
public:
    bool isSubsequence(string s, string t) {
        int n = t.size();

        int fast = 0;
        int slow = 0;
       

        if(s == ""){
            return true;
        }


      else{
          while(fast<n && slow < s.size()){
            if(t[fast] ==s[slow]){
                fast++;
                slow++;
            }
            else{
                    fast++;
            }
          }
      }       

    if(slow == s.size()){
            return true;
    }
         
        return false;
    }
};









