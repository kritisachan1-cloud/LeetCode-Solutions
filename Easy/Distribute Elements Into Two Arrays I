        int n = nums.size();

        vector<int> arr1;
        arr1.push_back(nums[0]);

        vector<int> arr2;
        arr2.push_back(nums[1]);

        for(int i=2;i<n;i++){
            if(arr1.back() > arr2.back()){
                arr1.push_back(nums[i]);
            }
            else{
                arr2.push_back(nums[i]);
            }
        }
int s1 = arr1.size();
int s2 = arr2.size();
int i=0;
for(int u=0;u<s2;u++){
    arr1.push_back(arr2[u]);
    
}


return arr1;
        
    }
};
